# Copy to .env.local. Demo requires no credentials and makes no external calls.
ERRBY_MODE=demo
# Clerk development instance for local/test. Never mix test and live keys.
# Dashboard > API keys; only the publishable key is exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact issuer (https://your-instance.clerk.accounts.dev), no trailing slash.
CLERK_ISSUER_URL=
# Exact browser origin; use the same hostname/port in Clerk and your browser.
ERRBY_APP_ORIGIN=http://127.0.0.1:3000
# Optional password-based browser acceptance; synthetic account only.
CLERK_TEST_IDENTIFIER=
CLERK_TEST_PASSWORD=
CLERK_TEST_USER_ID=
# All three server-only values AND Clerk configuration above are required live.
# Apply every SQL migration in filename order to that hosted test project first.
# Use a configured non-local synthetic test project. Local Docker is prohibited.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Privileged key: never expose through NEXT_PUBLIC_ or browser code.
SUPABASE_SECRET_KEY=
# Optional migration-only PostgreSQL connection, never used in the browser.
# On IPv4-only machines use the dashboard's Session pooler URL (port 5432).
# Keep its password private; application Auth/database clients use SUPABASE_URL.
SUPABASE_DB_URL=
# Operator CLI only: comma-separated approved teacher emails. Teachers must
# already have a provider-confirmed Clerk account; this does not bypass verification.
ERRBY_APPROVED_TEACHER_EMAILS=
# Explicit opt-in for account:manage against a synthetic hosted test project only.
ERRBY_OPERATOR_CONFIRM=
# Server-only provider. Live calls also require an enabled database budget.
# Only gpt-4.1-mini (or openai/gpt-4.1-mini) is accepted with verified price limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4.1-mini
