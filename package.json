{
  "name": "errby",
  "version": "0.1.0",
  "description": "Errby local development foundation",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/foundation.test.ts tests/database.test.ts tests/lessons.test.ts && npm run test:identity && npm run test:ingestion && npm run test:preparations && npm run test:sessions && npm run test:classes && npm run test:teacher-review",
    "test:identity": "node --conditions=react-server --import tsx --test tests/identity.test.ts",
    "test:ingestion": "node --conditions=react-server --import tsx --test tests/ingestion.test.ts",
    "test:preparations": "node --conditions=react-server --import tsx --test tests/preparations.test.ts",
    "account:manage": "node --conditions=react-server --env-file=.env.local --import tsx scripts/accounts.ts",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "db:test": "tsx --test tests/database.test.ts",
    "test:sessions": "node --conditions=react-server --import tsx --test tests/sessions.test.ts",
    "test:classes": "node --conditions=react-server --import tsx --test tests/classes.test.ts",
    "test:teacher-review": "node --conditions=react-server --import tsx --test tests/teacher-review.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0"
}
